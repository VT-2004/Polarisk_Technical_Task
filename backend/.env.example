# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/callback"

# LLM Configuration (Groq is free & fast; Anthropic Claude can also be used)
LLM_PROVIDER="groq" # "groq" or "anthropic"
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL="llama-3.3-70b-versatile" # or "llama-3.1-8b-instant"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"

# Session & Security
SESSION_SECRET_KEY="spend-intel-super-secret-session-key-change-in-production"
FRONTEND_URL="http://localhost:3000"

# Application Settings
DEBUG="true"
DATABASE_URL="sqlite:///./spend_intel.db"
